# Conexão com PostgreSQL (obrigatório)
# Neon: copie a "Connection string" do painel do projeto (aba Connection Details)
# Use a URL do pooler para Render (evita limite de conexões no free tier)
# Formato direto:  postgresql://user:senha@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Formato pooler:  postgresql://user:senha@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://user:senha@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Segredo JWT — troque por uma string longa e aleatória em produção
JWT_SECRET=troque_por_um_segredo_seguro

# OpenAI API Key — obtenha em https://platform.openai.com/api-keys
# Usado exclusivamente pelo Lion (assistente financeiro IA)
OPENAI_API_KEY=sk-...

# Configuração SMTP para recuperação de senha
SMTP_SERVICE=gmail
SMTP_USER=seu@email.com
SMTP_PASS=sua_app_password
SMTP_FROM=Cash Control <seu@email.com>

# Opcional: taxa de bancos externos (URL de um JSON público com taxas)
# TAXAS_BANCOS_URL=https://...

# Opcional: usar taxas padrão locais como fallback
# USE_LOCAL_DEFAULT_RATES=true

# Opcional: intervalo de atualização de taxas em horas (padrão: 6)
# RENDIMENTO_SYNC_HOURS=6

# Ambiente (railway/render define automaticamente)
NODE_ENV=production
